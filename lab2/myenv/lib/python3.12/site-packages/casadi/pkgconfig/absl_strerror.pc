prefix=/work/build/external_projects
exec_prefix=${prefix}
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: absl_strerror
Description: Abseil strerror library
URL: https://abseil.io/
Version: 20250127
Requires: absl_config = 20250127, absl_core_headers = 20250127, absl_errno_saver = 20250127
Libs: -L${libdir}  -labsl_strerror 
Cflags: -I${includedir} -DNOMINMAX
