prefix=/work/build/external_projects
exec_prefix=${prefix}
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: absl_log
Description: Abseil log library
URL: https://abseil.io/
Version: 20250127
Requires: absl_log_internal_log_impl = 20250127, absl_vlog_is_on = 20250127
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
