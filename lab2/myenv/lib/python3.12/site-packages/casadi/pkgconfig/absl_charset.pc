prefix=/work/build/external_projects
exec_prefix=${prefix}
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: absl_charset
Description: Abseil charset library
URL: https://abseil.io/
Version: 20250127
Requires: absl_config = 20250127, absl_string_view = 20250127
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
