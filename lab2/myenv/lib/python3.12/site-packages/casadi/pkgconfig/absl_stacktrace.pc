prefix=/work/build/external_projects
exec_prefix=${prefix}
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: absl_stacktrace
Description: Abseil stacktrace library
URL: https://abseil.io/
Version: 20250127
Requires: absl_debugging_internal = 20250127, absl_config = 20250127, absl_core_headers = 20250127, absl_dynamic_annotations = 20250127, absl_raw_logging_internal = 20250127
Libs: -L${libdir}  -labsl_stacktrace 
Cflags: -I${includedir} -DNOMINMAX
