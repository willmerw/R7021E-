prefix=/work/build/external_projects
exec_prefix=${prefix}
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: absl_demangle_rust
Description: Abseil demangle_rust library
URL: https://abseil.io/
Version: 20250127
Requires: absl_config = 20250127, absl_core_headers = 20250127, absl_decode_rust_punycode = 20250127
Libs: -L${libdir}  -labsl_demangle_rust 
Cflags: -I${includedir} -DNOMINMAX
