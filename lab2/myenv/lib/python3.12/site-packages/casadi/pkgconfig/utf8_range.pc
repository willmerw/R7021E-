prefix=/work/build/external_projects
exec_prefix=/work/build/external_projects
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: UTF8 Range
Description: Google's UTF8 Library
Version: 1.0
Requires: absl_strings
Libs: -L${libdir} -lutf8_validity -lutf8_range -lpthread
Cflags: -I${includedir}
