prefix=/work/build/external_projects
exec_prefix=${prefix}
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: absl_int128
Description: Abseil int128 library
URL: https://abseil.io/
Version: 20250127
Requires: absl_compare = 20250127, absl_config = 20250127, absl_core_headers = 20250127, absl_bits = 20250127
Libs: -L${libdir}  -labsl_int128 
Cflags: -I${includedir} -DNOMINMAX
