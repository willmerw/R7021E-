prefix=/work/build/external_projects
exec_prefix=${prefix}
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: absl_debugging
Description: Abseil debugging library
URL: https://abseil.io/
Version: 20250127
Requires: absl_stacktrace = 20250127, absl_leak_check = 20250127
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
