prefix=/work/build/external_projects
exec_prefix=${prefix}
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: absl_log_sink
Description: Abseil log_sink library
URL: https://abseil.io/
Version: 20250127
Requires: absl_config = 20250127, absl_log_entry = 20250127
Libs: -L${libdir}  -labsl_log_sink 
Cflags: -I${includedir} -DNOMINMAX
