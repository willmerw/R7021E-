prefix=/work/build/external_projects
exec_prefix=${prefix}
libdir=/work/build/external_projects/lib
includedir=/work/build/external_projects/include

Name: absl_cleanup_internal
Description: Abseil cleanup_internal library
URL: https://abseil.io/
Version: 20250127
Requires: absl_base_internal = 20250127, absl_core_headers = 20250127, absl_utility = 20250127
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
