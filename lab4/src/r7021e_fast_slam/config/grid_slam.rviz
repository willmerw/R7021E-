Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 20
  - Class: rviz_default_plugins/Map
    Name: SLAM Map
    Enabled: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Color Scheme: map
  - Class: rviz_default_plugins/PoseArray
    Name: Particles
    Enabled: true
    Topic:
      Value: /particles
      Reliability Policy: Reliable
    Shape: Arrow (Flat)
    Color: 255; 85; 0
    Arrow Length: 0.2
  - Class: rviz_default_plugins/Path
    Name: SLAM Path
    Enabled: true
    Topic:
      Value: /slam_path
      Reliability Policy: Reliable
    Color: 25; 255; 25
    Line Width: 0.02
  - Class: rviz_default_plugins/Odometry
    Name: Best particle
    Enabled: true
    Topic:
      Value: /best_particle
      Reliability Policy: Reliable
    Shape: Arrow
    Color: 25; 175; 90
    Shaft Length: 0.3
    Shaft Radius: 0.03
    Head Length: 0.1
    Head Radius: 0.06
    Covariance:
      Value: true
      Position:
        Value: true
        Alpha: 0.3
        Color: 25; 175; 90
        Scale: 1.0
      Orientation:
        Value: true
        Alpha: 0.5
        Color: 25; 175; 90
        Color Style: Unique
        Scale: 1.0
        Offset: 1.0
    Keep: 1
    Position Tolerance: 0.0
    Angle Tolerance: 0.0
  - Class: rviz_default_plugins/LaserScan
    Name: Scan
    Enabled: true
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
    Size (m): 0.03
    Color: 0; 170; 255
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Names: true
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 80
      Target Frame: map
